  "threads": [
    {
      "id": "6143ac7f-266d-40a2-9e15-be46a10b9941",
      "contactId": "97ee0517-0fee-4d0b-95e2-0640860750ce",
      "messages": [
        {
          "id": "a31affcb-45c6-4dba-87ff-e63ff7592f95",
          "kind": "date",
          "text": "4월 13일 화요일",
          "dateParts": {
            "mode": "calendar",
            "month": 4,
            "day": 13,
            "weekday": 2
          }
        },
        {
          "id": "48827866-e0d6-45eb-a78f-646927ed6d65",
          "from": "them",
          "text": "똑똑~",
          "time": "20:28"
        },
        {
          "id": "ce715ee5-e3d0-4d9f-9188-0cc6cda436eb",
          "from": "them",
          "text": "계세여?",
          "time": "20:30"
        },
        {
          "id": "6a9c2f8d-88ef-4183-93a5-761195331d01",
          "from": "me",
          "text": "누구십니까?",
          "time": "20:29"
        },
        {
          "id": "151905f3-f20c-4fd1-bd70-98692c399cba",
          "from": "them",
          "text": "누구 아닌뎅. 그대가 전번을 뜯어다 나에게 아주아주 수줍게 쥐여 주지 않았나.",
          "time": "20:37"
        },
        {
          "id": "770f56cb-a777-4592-962d-420949e78574",
          "from": "me",
          "text": "설마 그때 철거? 호열이 형?",
          "time": "20:38"
        },
        {
          "id": "d72161c0-265c-4855-8ca7-c7819cd05313",
          "from": "me",
          "text": "맞아요?",
          "time": "20:38"
        },
        {
          "id": "0a75f46b-1f52-4e52-bcee-d83b7c98532a",
          "from": "them",
          "text": "웅. 한 달밖에 안 지났는데 기억력이 영 별로다잉.",
          "time": "20:41"
        },
        {
          "id": "82b50dd6-9525-4f2a-b84d-ec9ded0d699c",
          "from": "me",
          "text": "연락 없어서 존나 뻥 차인 줄 알았는데요...............",
          "time": "20:43"
        },
        {
          "id": "31531b19-6faa-4534-8009-37309aace99b",
          "from": "them",
          "text": "뻥은 쩌기 조기축구 아저씨들이 공 찰 때나 나는 소리고. 요기 나는 드디어 휴가를 나왔다, 이 말이에용.",
          "time": "20:48"
        },
        {
          "id": "9aa27ccb-7660-4812-bf07-6af7cd3ba4a6",
          "from": "them",
          "text": "무려 포상휴가. 어때, 막. 안 기쁜가? 엉?",
          "time": "20:49"
        },
        {
          "id": "12f0e889-4fdb-4603-b153-d889fa8d7222",
          "from": "me",
          "text": "지금그말은절만나주겠단뜻?",
          "time": "20:50"
        },
        {
          "id": "38188ea1-8374-408f-b2d4-916f43fd5891",
          "from": "them",
          "text": "빙고. 말년 군인 좀 놀아줭.",
          "time": "20:52"
        },
        {
          "id": "4faec97b-fb92-45c4-8d26-0ecbdfe3ebe1",
          "from": "me",
          "text": "당장 전화 걸게여.",
          "time": "20:58"
        }
      ],
      "draft": "",
      "timelineVersion": 1
    },
    {
      "id": "f2cdd02a-647e-406b-a433-35e7c795d08c",
      "contactId": "04208ce4-2308-41de-9da7-5c660a21780c",
      "messages": [
        {
          "id": "0f1d67e4-cf17-46e6-b815-dfdf4d01ce58",
          "kind": "date",
          "text": "2월 7일 월요일",
          "dateParts": {
            "mode": "calendar",
            "month": 2,
            "day": 7,
            "weekday": 1
          }
        },
        {
          "id": "0d279d24-a175-449d-8976-4ed49b942a80",
          "from": "me",
          "text": "안녕하세요. 부재중이셔서 메세지로 연락드립니다. \n\n[고강/21세/남]\n\n군필자(육군 11군번)이고 건설업 기초안전보건교육 이수증 보유하고 있습니다. 시켜만 주신다면 당장 내일부터 출근 가능하고, 현장 일 있으면 연락 부탁드립니다.",
          "time": "20:08"
        },
        {
          "id": "97a03b1f-6fbc-4564-a7d1-1328da0dfeac",
          "from": "them",
          "text": "이따가 전화 줄게요",
          "time": "20:12"
        },
        {
          "id": "267e52e3-6114-423e-acc9-900cb70b0af4",
          "from": "me",
          "text": "넵 알겠습니다.",
          "time": "20:12"
        },
        {
          "id": "a96ef232-e163-469c-9a9b-c32f801bb8bc",
          "kind": "date",
          "text": "2월 8일 화요일",
          "dateParts": {
            "mode": "calendar",
            "month": 2,
            "day": 8,
            "weekday": 2
          }
        },
        {
          "id": "d9d43ccb-b5bf-4e10-a21a-90c52039075c",
          "from": "them",
          "text": "내일 08시까지 알려 준 장소로 출근하세요.",
          "time": "20:14"
        },
        {
          "id": "343cbae4-b6ec-4f66-b6ae-26f86a56c127",
          "from": "me",
          "text": "내일 뵙겠습니다. 감사합니다!!",
          "time": "20:14"
        },
        {
          "id": "b81ce49e-b684-4d86-a637-3388649766f4",
          "kind": "date",
          "text": "2월 9일 수요일",
          "dateParts": {
            "mode": "calendar",
            "month": 2,
            "day": 9,
            "weekday": 3
          }
        },
        {
          "id": "9971844b-a15f-4d91-b57f-1014de40768a",
          "from": "them",
          "text": "입금내역 확인하세요.",
          "time": "20:15"
        },
        {
          "id": "5a86c726-2b41-4fd8-ae33-564436841bc2",
          "from": "me",
          "text": "확인했습니다.",
          "time": "20:15"
        },
        {
          "id": "2db3892c-1c53-43a2-901f-e3295519086b",
          "kind": "date",
          "text": "3월 26일 토요일",
          "dateParts": {
            "mode": "calendar",
            "month": 3,
            "day": 26,
            "weekday": 6
          }
        },
        {
          "id": "16bbae6b-713a-4258-b656-5f3b11e488c5",
          "from": "them",
          "text": "미안한데 오늘 시간 있나?",
          "time": "20:19"
        },
        {
          "id": "9e581fcf-db67-47e8-847a-4b467b232496",
          "from": "them",
          "text": "누구 하나 빵꾸내고 튀어서 자리 비는데 하고싶음 꽂아줄라니까 생각 있으면 전화해라",
          "time": "20:20"
        },
        {
          "id": "7ddf2d30-781b-4bf3-92c8-11c6ef59b984",
          "from": "me",
          "text": "오늘 시간 됩니다 팀장님 전화 드리겠슴다",
          "time": "20:20"
        },
        {
          "id": "370a2250-3cca-42a4-973c-6e278b77f74a",
          "kind": "date",
          "text": "4월 15일 일요일",
          "dateParts": {
            "mode": "calendar",
            "month": 4,
            "day": 15,
            "weekday": 0
          }
        },
        {
          "id": "fb549e2c-5c12-478d-b2ca-50559e06131d",
          "from": "them",
          "text": "어야 몸은 괜찮냐? 회복하고 와라",
          "time": "20:22"
        },
        {
          "id": "f4a3e2c6-c1ad-47f0-ac0d-5d6285ef1c37",
          "from": "me",
          "text": "네 죄송합니다 ㅠㅠ 담에 배로 뛰겠습니다",
          "time": "20:23"
        },
        {
          "id": "0bd20f3f-ef7f-4cd0-ba5d-b18c27661905",
          "kind": "date",
          "text": "4월 18일 수요일",
          "dateParts": {
            "mode": "calendar",
            "month": 4,
            "day": 18,
            "weekday": 3
          }
        },
        {
          "id": "4828957e-6ee7-4f66-9f9e-a40f32bbaeeb",
          "from": "me",
          "text": "내일부터 정상출근 가능합니다.",
          "time": "20:25"
        },
        {
          "id": "de4192d6-0df0-4355-839e-1d77e872f2a4",
          "from": "them",
          "text": "저녁에 전화 줄게~",
          "time": "20:26"
        },
        {
          "id": "1321eb03-fc0d-4872-a79e-95cf0bcdf204",
          "from": "me",
          "text": "넵!",
          "time": "20:26"
        }
      ],
      "draft": "",
      "timelineVersion": 1
    }
  ],
